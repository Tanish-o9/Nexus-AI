# ==============================================================================
# Nexus PM — ML Service Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=8002
DEBUG=true

# Database URI (for extracting batch workload logs to train recommendation engine)
# ------------------------------------------------------------------------------
DB_URL=postgresql://nexus_user:nexus_secure_password_replace_me@db:5432/nexus_db

# Memory & Lock Caches
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Model Registry
# ------------------------------------------------------------------------------
# Directory where trained .pkl, .onnx, or tensor checkpoints are serialized
MODEL_REGISTRY_PATH=/app/ml-service/models

# Recommendation Thresholds & Monitoring
# ------------------------------------------------------------------------------
# Threshold to raise concept drift triggers in the pipeline (0.0 to 1.0)
DRIFT_THRESHOLD=0.15
