# Service
APP_NAME=nexus-ai-service
DEBUG=true

# Internal auth — must match backend INTERNAL_SERVICE_SECRET
INTERNAL_SERVICE_SECRET=change-me-in-prod

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Optional: enables the read-only GitHub issue search tool
GITHUB_TOKEN=github_pat_your-token-here

# PostgreSQL (pgvector — same DB as backend)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_dev

# Backend URL (for internal callbacks e.g. agent-completed notification)
BACKEND_URL=http://localhost:8000

# Redis (LangGraph checkpointer)
REDIS_URL=redis://localhost:6379/1

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
