# ==============================================================================
# Nexus PM Global Environment Variables Template
# Copy this file to .env before starting services.
# ==============================================================================

# Global Project Settings
# ------------------------------------------------------------------------------
ENV=development
COMPOSE_PROJECT_NAME=nexus_pm
DEBUG=true

# Frontend Configurations (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Backend Configurations (Django + DRF)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production-with-a-secure-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Databases & Cache
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexus_db
DB_USER=nexus_user
DB_PASSWORD=nexus_secure_password_replace_me
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# AI Microservice Configurations (FastAPI + LangChain)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8001
OPENAI_API_KEY=your_openai_api_key_here
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=nexus-pm

# ML Microservice Configurations
# ------------------------------------------------------------------------------
ML_SERVICE_PORT=8002

# Vector Database (pgvector)
# ------------------------------------------------------------------------------
VECTOR_DB_URL=postgresql://nexus_user:nexus_secure_password_replace_me@db:5432/nexus_db

# Elasticsearch (Search Infrastructure)
# ------------------------------------------------------------------------------
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTIC_PASSWORD=elastic_secure_password_replace_me
