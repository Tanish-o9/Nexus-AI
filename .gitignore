# ==============================================================================
# Nexus PM Monorepo Git Ignore Config
# ==============================================================================

# Node / Frontend (Next.js)
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
frontend/.yarn/cache/
frontend/.yarn/unplugged/
frontend/.yarn/build-state.yml
frontend/.yarn/install-state.gz
frontend/.pnpm-debug.log*

# Python / Django / FastAPI (backend, ai-service, ml-service)
# ------------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/pip-log.txt
**/pip-delete-this-directory.txt
**/*.egg-info/
**/develop-eggs/
**/downloads/
**/eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/share/python-wheels/
**/*.egg
**/manifest
**/spec
**/build/
**/dist/
**/local_settings.py
**/db.sqlite3
**/db.sqlite3-journal
**/.webcon/

# Python Virtual Environments
.venv/
venv/
ENV/
env/
**/venv/
**/.venv/

# Environment Variables & Secrets (Do not commit actual credentials!)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.production

# Operating System & IDEs
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker & Databases
# ------------------------------------------------------------------------------
docker/data/
docker/pg_data/
docker/redis_data/
docker/elastic_data/
**/*.db
**/*.sqlite
