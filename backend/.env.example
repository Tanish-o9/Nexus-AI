# Django
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=your-secret-key-here

# PostgreSQL
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (prod only, comma-separated)
CORS_ALLOWED_ORIGINS=https://app.nexuspm.io

# Allowed hosts (prod only, comma-separated)
ALLOWED_HOSTS=api.nexuspm.io

# Internal service auth (AI service → backend)
INTERNAL_SERVICE_SECRET=change-me-in-prod
AI_SERVICE_URL=http://localhost:8001

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:3000

# Email (prod)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-key
DEFAULT_FROM_EMAIL=noreply@nexuspm.io
